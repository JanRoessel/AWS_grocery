# Copy this file to terraform.tfvars and fill in real values.
# terraform.tfvars is gitignored - never commit real secrets.

key_pair_name  = "your-existing-ec2-key-pair-name"
s3_bucket_name = "your-globally-unique-bucket-name"

# Prefer TF_VAR_db_password / TF_VAR_jwt_secret_key env vars over putting
# real secrets in this file, even though it's gitignored.
# db_password    = "change-me"
# jwt_secret_key = "change-me"
